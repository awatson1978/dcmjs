{"nodes": [{"id": "packages_docs_docs_performance_performance", "label": "Performance (measured numbers, gates, caveats)", "file_type": "document", "source_file": "packages/docs/docs/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three legs: offsets-only tokenizer deferring all decoding, a writer that copies clean bytes instead of re-encoding, and standing gates that prevent regression. Honest caveats: single-machine timings; first access pays the decode; eager fallback loses laziness; charset passthrough is conservative; memory is ~1x the file because the source buffer stays alive as long as any entry does."}], "edges": [{"source": "packages_docs_docs_performance_performance", "target": "packages_docs_docs_development_monorepo_gate_philosophy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/performance.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_performance_performance", "target": "packages_docs_docs_architecture_dictionary_packed_dictionary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/performance.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_performance_performance", "target": "packages_docs_docs_architecture_writer_backpatch_writer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/performance.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_performance_performance", "target": "packages_docs_docs_architecture_writer_zero_copy_windows", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/performance.md", "source_location": null, "weight": 1.0}], "hyperedges": []}