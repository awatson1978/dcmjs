{"nodes": [{"id": "changelog", "label": "changelog.md", "file_type": "document", "source_file": "changelog.md", "source_location": null, "source_url": null, "captured_at": "2026-08-02", "author": null, "contributor": null}, {"id": "changelog_2026_08_02_deprecated_lazy_core", "label": "Changelog 2026-08-02 Deprecated: lazy read core + byte-identity passthrough write path", "file_type": "document", "source_file": "changelog.md", "source_location": "L7-16", "source_url": null, "captured_at": "2026-08-02", "author": null, "contributor": null, "rationale": "Stakeholder decision: the event-stream API delivers ~90% of the benefit; the remaining byte-identity 10% doesn't justify a second buffered read engine. readFile defaults to eager again; lazy selection emits a one-time warning; src/lazy/ and the passthrough path removed next release; writes remain correct DICOM but re-encoded."}, {"id": "changelog_2026_08_02_ad_1_implicit_sq", "label": "Changelog 2026-08-02 Changed: one implicit-SQ behavior (AD-1) \u2014 defined-length dictionary-unknown implicit elements decode as UN on every read path", "file_type": "document", "source_file": "changelog.md", "source_location": "L23-30", "source_url": null, "captured_at": "2026-08-02", "author": null, "contributor": null, "rationale": "Eager parity; decodeCore.resolveVrInstance is the single canonical contract. Previously fromPart10/fromPart10Stream promoted defined-length dictionary-unknown implicit elements to SQ while readFile returned UN. The parser's isSequence() peek now applies only to undefined-length elements, also fixing throws on defined-length values resembling item/delimiter tags."}, {"id": "changelog_2026_08_02_ed_1_deflate_relay", "label": "Changelog 2026-08-02 Fixed: deflate relay bounded memory (ED-1, Gate 5b)", "file_type": "document", "source_file": "changelog.md", "source_location": "L32-37", "source_url": null, "captured_at": "2026-08-02", "author": null, "contributor": null, "rationale": "A fast feed + slow listener could balloon the inflated bodyStream without bound (DEFLATE expands >100x). The relay now feeds pako in small sub-slices and pauses on a 16 KiB retention watermark with a demand-aware deadlock guard; Gate 5b pins the bound."}, {"id": "changelog_2026_08_02_ed_2_hermetic_gate", "label": "Changelog 2026-08-02 Changed: main test gate is hermetic (ED-2)", "file_type": "document", "source_file": "changelog.md", "source_location": "L19-22", "source_url": null, "captured_at": "2026-08-02", "author": null, "contributor": null, "rationale": "test_deflated uses vendored fixtures; the two multi-megabyte network-fixture suites skip unless cached or DCMJS_NETWORK_TESTS=1; a non-blocking CI job keeps them running."}], "edges": [{"source": "changelog", "target": "changelog_2026_08_02_deprecated_lazy_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "changelog.md", "source_location": "L7-16", "weight": 1.0}, {"source": "changelog", "target": "changelog_2026_08_02_ad_1_implicit_sq", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "changelog.md", "source_location": "L23-30", "weight": 1.0}, {"source": "changelog", "target": "changelog_2026_08_02_ed_1_deflate_relay", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "changelog.md", "source_location": "L32-37", "weight": 1.0}, {"source": "changelog", "target": "changelog_2026_08_02_ed_2_hermetic_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "changelog.md", "source_location": "L19-22", "weight": 1.0}, {"source": "changelog_2026_08_02_deprecated_lazy_core", "target": "claude_refactor_analysis_d28_lazy_core_deprecation", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "changelog.md", "source_location": "L9-16", "weight": 1.0}, {"source": "changelog_2026_08_02_deprecated_lazy_core", "target