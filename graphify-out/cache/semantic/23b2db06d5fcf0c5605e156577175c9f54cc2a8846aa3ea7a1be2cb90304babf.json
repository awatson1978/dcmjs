{"nodes": [{"id": "packages_docs_docs_guides_naturalized_datasets_naturalizedataset", "label": "DicomMetaDictionary.naturalizeDataset", "file_type": "concept", "source_file": "packages/docs/docs/guides/naturalized-datasets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_guides_naturalized_datasets_denaturalizedataset", "label": "DicomMetaDictionary.denaturalizeDataset", "file_type": "concept", "source_file": "packages/docs/docs/guides/naturalized-datasets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only emits names it finds in the name map \u2014 hex-named (private) entries are silently dropped with a log.warn, so a naturalize/denaturalize round trip loses private data. Entries it builds carry no source-span bookkeeping, so the passthrough writer re-encodes all of them: value-faithful but not byte-faithful."}, {"id": "packages_docs_docs_guides_naturalized_datasets_single_value_collapse", "label": "Instance-Driven Single-Value Collapse", "file_type": "concept", "source_file": "packages/docs/docs/guides/naturalized-datasets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 0.x rule carried into 1.0-beta unchanged: a one-element Value array collapses to a scalar, so the same attribute can be a scalar in one file and an array in another \u2014 the single most common dcmjs 0.x complaint, and the subject of the open VM-driven-shapes 1.0 decision."}, {"id": "packages_docs_docs_guides_naturalized_datasets_vrmap_meta", "label": "_vrMap and _meta Magic Keys", "file_type": "concept", "source_file": "packages/docs/docs/guides/naturalized-datasets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "packages_docs_docs_guides_naturalized_datasets_naturalizedataset"