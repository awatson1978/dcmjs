{"nodes": [{"id": "packages_docs_docs_architecture_event_stream_event_stream_contract", "label": "Event-Stream Contract", "file_type": "concept", "source_file": "packages/docs/docs/architecture/event-stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hybrid contract: synchronous push core (allocation-free hot path) with an async-iterator adapter for for-await ergonomics. Separates sources, stream, listeners, and retained representation so readers, writers, naturalizers, validators, and anonymizers compose on one contract. Invariants: loss preservation, well-formed nesting, transport-only binary, out-of-band diagnostics, optional sourceSpan."}, {"id": "packages_docs_docs_architecture_event_stream_frompart10", "label": "fromPart10 (buffered Part 10 source)", "file_type": "concept", "source_file": "packages/docs/docs/architecture/event-stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_event_stream_fromdataset", "label": "fromDataSet (parsed dataset source)", "file_type": "concept", "source_file": "packages/docs/docs/architecture/event-stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_event_stream_fromdicomwebjson", "label": "fromDicomWebJson (DICOMweb JSON source)", "file_type": "concept", "source_file": "packages/docs/docs/architecture/event-stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_event_stream_decodecore", "label": "decodeCore (shared decode module, src/core/decodeCore.js)", "file_type": "concept", "source_file": "packages/docs/docs/architecture/event-stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "ra