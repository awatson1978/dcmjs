{"nodes": [{"id": "packages_docs_docs_guides_writing_and_editing_dicomdict_write", "label": "DicomDict.write (Part 10 serialization)", "file_type": "concept", "source_file": "packages/docs/docs/guides/writing-and-editing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_guides_writing_and_editing_assignment_based_editing", "label": "Assignment-Based Editing Rules", "file_type": "concept", "source_file": "packages/docs/docs/guides/writing-and-editing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assignments (entry.Value=, entry._rawValue=, upsertTag) are tracked at any depth and dirty the enclosing SQ chain; in-place mutation of a materialized value is undetectable and silently discarded by the passthrough writer. Structural sequence edits (item count, key adds/deletes) ARE detected at write time; leaf in-place mutation and identical-key-set item swaps remain undetectable."}, {"id": "packages_docs_docs_guides_writing_and_editing_upserttag", "label": "DicomDict.upsertTag", "file_type": "concept", "source_file": "packages/docs/docs/guides/writing-and-editing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_guides_writing_and_editing_writeoptions", "label": "writeOptions (allowInvalidVRLength, fragmentMultiframe)", "file_type": "concept", "source_file": "packages/docs/docs/guides/writing-and-editing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "allowInvalidVRLength gates write-time validation on the re-encode path only \u2014 byte-faithful passthrough legitimately preserves invalid stored lengths, so a no-edit rewrite of a file with an over-long value succeeds even with the default false. fragmentMultiframe:false asks for bytes the source does not contain, so it disables passthrough for the whole dict."}], "edges": [{"source": "packages_docs_docs_guides_writing_and_editing_dicomdict_write", "target": "packages_docs_docs_architecture_writer_passthrough_fast_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/guides/writing-and-editing.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_guides_writing_and_editing_assignment_based_editing", "target": "packages_docs_docs_architecture_writer_dirty_tracking", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/guides/writing-and-editing.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_guides_writing_and_editing_upserttag", "target": "packages_docs_docs_guides_writing_and_editing_dicomdict_write", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/guides/writing-and-editing.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_guides_writing_and_editing_writeoptions", "target": "packages_docs_docs_architecture_writer_passthrough_fast_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/guides/writing-and-editing.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_guides_writing_and_editing_dicomdict_write", "target": "packages_docs_docs_guides_deflate_deflated_transfer_syntax", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/guides/writing-and-editing.md", "source_location": null, "weight": 1.0}], "hyperedges": []}