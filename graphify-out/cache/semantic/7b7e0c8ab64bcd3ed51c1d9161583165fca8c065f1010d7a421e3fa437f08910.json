{"nodes": [{"id": "packages_docs_docs_architecture_dictionary_packed_dictionary", "label": "Packed Dictionary System", "file_type": "concept", "source_file": "packages/docs/docs/architecture/dictionary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Naive object-literal dictionaries cost megabytes of parse/alloc at startup for every importer. Replacing literals with base64-encoded typed-array tables decoded once on first use dropped import cost from 181ms to 19ms (9.5x), keeping hot-path lookups at binary-search-plus-memo cost while keeping startup nearly free."}, {"id": "packages_docs_docs_architecture_dictionary_dicom_packed_js", "label": "src/dicom.packed.js (packed data tables)", "file_type": "concept", "source_file": "packages/docs/docs/architecture/dictionary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_dictionary_dicom_lookup_js", "label": "src/dicom.lookup.js (tag lookups)", "file_type": "concept", "source_file": "packages/docs/docs/architecture/dictionary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_dictionary_dictionary_fast_js", "label": "src/dictionary.fast.js (DicomMetaDictionary.dictionary Proxy facade)", "file_type": "concept", "source_file": "packages/docs/docs/architecture/dictionary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_docs_docs_architecture_dictionary_private_dictionary", "label": "Private Tag Dictionary", "file_type": "concept", "source_file": "packages/docs/docs/architecture/dictionary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registered at import as a thin lambda so importing dcmjs does zero private-dictionary work; the base64 index decode runs only on the first private-tag lookup."}, {"id": "packages_docs_docs_architecture_dictionary_lazy_name_map", "label": "Lazy nameMap (keyword-to-entry map)", "file_type": "concept", "source_file": "packages/docs/docs/architecture/dictionary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In 0.x the ~5000-entry nameMap was built at import time; 1.0 makes it a memoizing static getter built on first access so import time no longer pays for it. All existing access patterns go through the getter unchanged."}, {"id": "packages_docs_docs_architecture_dictionary_generate_pipeline", "label": "generate/ Dictionary Pipeline", "file_type": "concept", "source_file": "packages/docs/docs/architecture/dictionary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Packed modules are build artifacts with documented provenance: generate-dictionary.js downloads PS3.6/PS3.7 docbook XML from dicom.nema.org, pack_dicom.mjs flattens into sorted parallel arrays with dedup'd VR/VM code tables, bench-dictionary-load.mjs is the source of the 181ms-to-19ms measurement."}], "edges": [{"source": "packages_docs_docs_architecture_dictionary_packed_dictionary", "target": "packages_docs_docs_architecture_dictionary_dicom_packed_js", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/dictionary.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_dictionary_packed_dictionary", "target": "packages_docs_docs_architecture_dictionary_dicom_lookup_js", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/docs/docs/architecture/dictionary.md", "source_location": null, "weight": 1.0}, {"source": "packages_docs_docs_architecture_dictionary_packed_dictionary", "target"